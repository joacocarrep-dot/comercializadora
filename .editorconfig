
# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Python files
[*.py]
indent_size = 4
max_line_length = 88
quote_type = "double"

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.yml]
[*.yaml]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# Docker files
[Dockerfile]
[Dockerfile.*]
[*.dockerfile]
indent_style = space
indent_size = 4

# Shell scripts
[*.sh]
indent_style = tab
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab

# Configuration files
[*.ini]
[*.toml]
indent_style = space
indent_size = 2

# HTML, CSS, JS (for future frontend)
[*.html]
indent_style = space
indent_size = 2

[*.css]
indent_style = space
indent_size = 2

[*.js]
indent_style = space
indent_size = 2

# Git files
[.gitignore]
[.gitattributes]
indent_style = space
indent_size = 2

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Environment files
[*.env]
[.env.*]
indent_style = space
indent_size = 2

# Documentation
[*.rst]
indent_style = space
indent_size = 3

# Templates
[*.j2]
[*.jinja2]
indent_style = space
indent_size = 2

# Override for test files (allow longer lines for test names)
[tests/**/*.py]
max_line_length = 100

# Override for migrations (alembic)
[migrations/versions/*.py]
max_line_length = 100

# Override for setup.py
[setup.py]
max_line_length = 100
