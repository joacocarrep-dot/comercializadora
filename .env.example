

# Configuración de entorno para Comercializadora Digital Backend
# Copiar a .env y modificar los valores según el entorno

# Entorno (development, staging, production)
ENVIRONMENT=development

# Base de datos
DATABASE_URL=postgresql://comercializadora:comercializadora@localhost:5432/comercializadora

# Seguridad
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (para desarrollo)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Integraciones (configuración de ejemplo)
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
GEMINI_API_KEY=your_gemini_api_key
WHATSAPP_API_TOKEN=your_whatsapp_api_token
SENDGRID_API_KEY=your_sendgrid_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

