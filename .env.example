

# Configuración de entorno para Comercializadora Digital Backend
# Copiar a .env y modificar los valores según el entorno
# Las variables están definidas en app/config/settings.py

# ======================
# Entorno y aplicación
# ======================
ENVIRONMENT=development
DEBUG=False
APP_NAME=Comercializadora Digital
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# ======================
# Base de datos PostgreSQL
# ======================
DATABASE_URL=postgresql://comercializadora:comercializadora@localhost:5432/comercializadora
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ======================
# Seguridad y autenticación
# ======================
SECRET_KEY=dev-secret-key-change-in-production-with-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# CORS (Cross-Origin Resource Sharing)
# ======================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=*

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ======================
# Integraciones - Pagos (MercadoPago)
# ======================
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key

# ======================
# Integraciones - IA (Google Gemini)
# ======================
GEMINI_API_KEY=your_gemini_api_key

# ======================
# Integraciones - Comunicación
# ======================
WHATSAPP_API_TOKEN=your_whatsapp_api_token
SENDGRID_API_KEY=your_sendgrid_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ======================
# Límites y timeouts
# ======================
REQUEST_TIMEOUT=30
MAX_UPLOAD_SIZE=10485760  # 10MB en bytes

# ======================
# Redis (opcional para cache)
# ======================
# REDIS_URL=redis://localhost:6379/0

# ======================
# Notas importantes:
# ======================
# 1. En producción, SECRET_KEY debe ser una cadena larga y segura
# 2. DATABASE_URL en producción debe usar SSL y credenciales seguras
# 3. Las variables de integraciones son opcionales para desarrollo
# 4. Para usar asyncpg, la URL debe ser: postgresql+asyncpg://usuario:contraseña@host:puerto/base_de_datos
# 5. En producción, DEBUG siempre debe ser False

